{
  "name": "@flametinary/dsh-phone-remote",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Open the DeepSeek Harness desktop Web UI from a phone on your LAN, or through an optional Cloudflare tunnel from anywhere, with an in-app settings page for ports, networks and access credentials. Host + client DSH plugin.",
  "license": "MIT",
  "author": {
    "name": "Sheldon"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "bin": {
    "dsh-phone-remote": "./bin/phone-remote.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "ui",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "bin",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "phone",
    "remote",
    "lan",
    "cloudflare",
    "tunnel"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlameTinary/dsh-phone-remote.git"
  },
  "homepage": "https://github.com/FlameTinary/dsh-phone-remote#readme",
  "bugs": {
    "url": "https://github.com/FlameTinary/dsh-phone-remote/issues"
  }
}
